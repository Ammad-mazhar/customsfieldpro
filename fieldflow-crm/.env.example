# FieldFlow Frontend — Environment Variables (Vite)
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.
# All variables here are PUBLICLY VISIBLE in the browser bundle.
# NEVER put secret keys here.

# ── API ───────────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3001

# ── Supabase (public keys only) ───────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# ── Maps ──────────────────────────────────────────────────────────────────────
VITE_GOOGLE_MAPS_API_KEY=AIza...

# ── Stripe (publishable key only — never the secret key) ─────────────────────
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# ── NEVER put these in frontend .env ──────────────────────────────────────────
# SUPABASE_SERVICE_KEY  ← backend only
# STRIPE_SECRET_KEY     ← backend only
# JWT secrets           ← backend only
# ANTHROPIC_API_KEY     ← backend only
# TWILIO_AUTH_TOKEN     ← backend only
